.reticle {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 780px;
    height: 500px;
    translate: -50% -46%;
}

.corner {
    position: absolute;
    width: 96px;
    height: 96px;
    border-color: var(--c-accent);
}

.corner--tl { left: 0; top: 0; border-left-width: 8px; border-top-width: 8px; border-top-left-radius: 28px; }
.corner--tr { right: 0; top: 0; border-right-width: 8px; border-top-width: 8px; border-top-right-radius: 28px; }
.corner--bl { left: 0; bottom: 0; border-left-width: 8px; border-bottom-width: 8px; border-bottom-left-radius: 28px; }
.corner--br { right: 0; bottom: 0; border-right-width: 8px; border-bottom-width: 8px; border-bottom-right-radius: 28px; }

.result__photo {
    width: 520px;
    height: 330px;
    border-radius: 24px;
    -unity-background-scale-mode: scale-and-crop;
}

.result__name-line {
    flex-direction: row;
    align-items: center;
    margin-top: 18px;
}

.result__dot {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    margin-right: 16px;
}

.result__name {
    font-size: 56px;
    -unity-font-definition: url("project://database/Assets/DiscoverTunisia/UI/Fonts/Poppins-Bold-SDF.asset");
}
