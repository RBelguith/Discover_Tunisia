<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="project://database/Assets/DiscoverTunisia/UI/Styles/Theme.uss" />
    <ui:Style src="Home.uss" />
    <ui:VisualElement name="screen" class="screen" picking-mode="Ignore">
        <ui:VisualElement class="home__content" picking-mode="Ignore">
            <ui:Label text="PATRIMOINE TUNISIEN EN 3D ET EN RÉALITÉ AUGMENTÉE" class="eyebrow" />
            <ui:VisualElement class="home__title-row" picking-mode="Ignore">
                <ui:Label text="Discover" class="home__title" />
                <ui:Label text="Tunisia" class="home__title home__title--accent" />
            </ui:VisualElement>
            <ui:Label text="Faites tourner le globe, explorez les monuments, la cuisine et les tenues de trois gouvernorats, puis posez un monument sur votre table en réalité augmentée." class="home__lead" />
            <ui:VisualElement class="home__chips" picking-mode="Ignore">
                <ui:VisualElement class="chip">
                    <ui:VisualElement class="icon icon--globe" />
                    <ui:Label text="Globe 3D interactif" />
                </ui:VisualElement>
                <ui:VisualElement class="chip">
                    <ui:VisualElement class="icon icon--pin" />
                    <ui:Label text="3 gouvernorats" />
                </ui:VisualElement>
                <ui:VisualElement class="chip">
                    <ui:VisualElement class="icon icon--ar" />
                    <ui:Label text="Réalité augmentée" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="startButton" class="btn btn--primary btn--large home__start">
                <ui:Label text="Commencer" />
                <ui:VisualElement class="icon icon--next icon--trailing" />
            </ui:Button>
        </ui:VisualElement>
        <ui:Label name="regionList" text="Nabeul · Bizerte · Kairouan" class="faint home__footer" />
    </ui:VisualElement>
</ui:UXML>
