.ident__body {
    position: absolute;
    left: 120px;
    right: 120px;
    top: 196px;
    bottom: 64px;
    flex-direction: row;
}

.ident__card {
    flex-grow: 1;
    flex-basis: 0;
}

.ident__card--scan {
    margin-right: 40px;
    align-items: center;
}

.ident__badge {
    width: 132px;
    height: 132px;
    margin-top: 12px;
    border-radius: 66px;
    align-items: center;
    justify-content: center;
    background-color: rgba(79, 195, 247, 0.14);
    border-width: 2px;
    border-color: rgba(79, 195, 247, 0.45);
}

.ident__badge > .icon {
    width: 64px;
    height: 64px;
    -unity-background-image-tint-color: var(--c-accent);
}

.ident__card-title {
    margin-top: 28px;
    font-size: 38px;
    -unity-font-definition: url("project://database/Assets/DiscoverTunisia/UI/Fonts/Poppins-Bold-SDF.asset");
}

.ident__card-text {
    margin-top: 14px;
    font-size: 26px;
    white-space: normal;
    -unity-text-align: upper-center;
    color: var(--c-text-2);
}

.spacer {
    flex-grow: 1;
}

.ident__note {
    margin-top: 18px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.ident__list {
    flex-grow: 1;
    margin-top: 24px;
}

.gov-row {
    flex-direction: row;
    align-items: center;
    height: 132px;
    padding: 0 26px 0 16px;
    margin: 0 0 18px 0;
    border-radius: 24px;
    border-width: 1px;
    border-color: var(--c-line);
    background-color: var(--c-panel-soft);
    transition-duration: 0.15s;
}

.gov-row:hover {
    background-color: var(--c-panel-hover);
}

.gov-row:active {
    scale: 0.98 0.98;
}

.gov-row__thumb {
    width: 150px;
    height: 100px;
    border-radius: 16px;
    -unity-background-scale-mode: scale-and-crop;
}

.gov-row__text {
    flex-grow: 1;
    margin-left: 26px;
}

.gov-row__name-line {
    flex-direction: row;
    align-items: center;
}

.gov-row__dot {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    margin-right: 14px;
}

.gov-row__name {
    font-size: 36px;
    -unity-font-definition: url("project://database/Assets/DiscoverTunisia/UI/Fonts/Poppins-Bold-SDF.asset");
}

.gov-row__subtitle {
    font-size: 24px;
    color: var(--c-text-2);
}

.gov-row > .icon {
    width: 36px;
    height: 36px;
    -unity-background-image-tint-color: var(--c-accent);
}
